{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm exec prisma generate && pnpm exec prisma migrate deploy",
    "prisma:generate": "pnpm exec prisma generate",
    "prisma:migrate:dev": "pnpm exec prisma migrate dev",
    "prisma:migrate:deploy": "pnpm exec prisma migrate deploy",
    "prisma:studio": "pnpm exec prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@types/pg": "^8.15.6",
    "@workspace/typescript-config": "workspace:*",
    "prisma": "^7.8.0",
    "typescript": "^5"
  },
  "exports": {
    ".": "./src/index.ts",
    "./articles": "./src/articles.ts",
    "./article-status": "./src/article-status.ts",
    "./categories": "./src/categories.ts",
    "./contact-channels": "./src/contact-channels.ts",
    "./media": "./src/media.ts",
    "./prisma": "./src/prisma.ts",
    "./users": "./src/users.ts"
  }
}
