generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id           String    @id @default(uuid())
  title        String
  summary      String
  content      String
  published_in DateTime?
  is_highlight Boolean   @default(false)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  cover_image_id String?
  cover_image    Media?  @relation(fields: [cover_image_id], references: [id], onDelete: SetNull)

  author_id String?
  author    User?   @relation(fields: [author_id], references: [id], onDelete: SetNull)

  tags       Tag[]
  categories Category[]

  @@index([author_id])
  @@map("articles")
}

model User {
  id         String   @id @default(uuid())
  auth0_id   String   @unique
  name       String
  email      String?
  picture    String?
  bio        String?
  website    String?
  instagram  String?
  linkedin   String?
  youtube    String?
  tiktok     String?
  x          String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  articles Article[]
  therapeutic_contract TherapeuticContract?

  @@map("users")
}

model TherapeuticContract {
  id                     String   @id @default(uuid())
  user_id                String   @unique
  full_name              String
  birth_date             DateTime @db.Date
  rg                     String
  cpf                    String
  email                  String
  contact                String
  address                String
  education_level        String
  profession             String
  ethnicity              String
  sexual_orientation     String
  pronouns               String
  gender                 String
  gender_other           String?
  marital_status         String
  has_children           Boolean
  children_count         Int?
  religion               String?
  has_disability         Boolean
  disability_details     String?
  needs_adaptation       Boolean?
  spouse                 String?
  emergency_contact_1_name         String
  emergency_contact_1_phone        String
  emergency_contact_1_relationship String
  emergency_contact_2_name         String
  emergency_contact_2_phone        String
  emergency_contact_2_relationship String
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("therapeutic_contracts")
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique

  articles Article[]

  @@map("tags")
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  articles Article[]

  @@map("categories")
}

model Media {
  id               String   @id @default(uuid())
  provider         String   @default("imagekit")
  provider_file_id String   @unique
  name             String
  alternative_text String?
  width            Int?
  height           Int?
  ext              String?
  mime             String?
  size             Int?
  url              String
  thumbnail_url    String?
  created_at       DateTime @default(now())

  articles_as_cover Article[]

  @@map("medias")
}

model ContactChannels {
  id         String   @id @default("main")
  youtube    String?
  linkedin   String?
  instagram  String?
  threads    String?
  facebook   String?
  whatsapp   String?
  tiktok     String?
  x          String?
  updated_at DateTime @updatedAt

  @@map("contact_channels")
}
